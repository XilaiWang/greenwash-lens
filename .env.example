# Server bind options for plain `npm start` development mode.
HOST=127.0.0.1
PORT=5173

# Optional storage override. Electron sets this automatically to app.getPath('userData').
# GREENWASH_USER_DATA_DIR=

# Set to 1 only when you intentionally need file:// pages to call the local API.
ALLOW_FILE_ORIGIN=0

# Pick one: none, openai, claude, gemini, deepseek
LLM_PROVIDER=none

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic Claude Messages API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Google Gemini generateContent API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek OpenAI-compatible chat completions API
# Current official model names include deepseek-v4-flash and deepseek-v4-pro.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional request timeout in milliseconds
LLM_TIMEOUT_MS=30000
